# Public site (lamirkohsa.dev). The admin studio is a separate project,
# lamirkohsa.cms, and keeps its own environment file.

# Shared Postgres database (Neon / Vercel Postgres / Supabase). Both projects
# read the same DATABASE_URL: the CMS writes, this site reads.
# On Vercel, POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, and
# DATABASE_URL_UNPOOLED are also accepted automatically alongside DATABASE_URL.
DATABASE_URL=
# POSTGRES_URL=

# Site / Canonical URL (metadataBase & Open Graph; defaults to Vercel URL or
# the production domain)
NEXT_PUBLIC_SITE_URL=

# Shared secret for the CMS -> site revalidation webhook. Set the same value on
# both projects; the CMS posts to https://<site>/api/revalidate after a save.
REVALIDATE_SECRET=

# Resend Email Integration (contact form + newsletter)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=ashokrimal.com.np
RESEND_WEBHOOK_SECRET=
RESEND_AUDIENCE_ID=
# Where contact-form submissions are emailed.
CONTACT_TO_EMAIL=

# Media & API integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ACCESS_TOKEN=
LASTFM_API_KEY=
GITHUB_TOKEN=

# Vercel Cron sends this as "Authorization: Bearer <value>" to the weekly
# IndexNow ping at /api/indexnow.
CRON_SECRET=

# Optional: forwards browser errors posted to /api/client-error to Rollbar.
ROLLBAR_SERVER_TOKEN=

# Search engines. Each token only appears in the page's verification meta tag,
# so an engine can prove the domain; leave them empty until you have one.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=

# Optional: override the IndexNow key. A custom key needs its own
# public/<key>.txt returning the same value.
INDEXNOW_KEY=

# Gemini API (project industry trends)
GEMINI_API_KEY=
