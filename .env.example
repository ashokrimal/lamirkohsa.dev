# Database connection (PostgreSQL / Neon / Vercel Postgres / Cloud SQL)
# On Vercel, POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, and
# DATABASE_URL_UNPOOLED are also accepted automatically alongside DATABASE_URL.
DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# DATABASE_URL_UNPOOLED=

# Site / Canonical URL (used for metadataBase & Open Graph; defaults to Vercel URL or production domain)
NEXT_PUBLIC_SITE_URL=

# Better Auth configuration
BETTER_AUTH_SECRET=
# BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:3000

# Optional bootstrap for the admin owner. On a fresh deployment visit
# /admin/sign-in and create the owner there instead; that account is stored in
# Postgres and its password can be changed from /admin/account. Set all three
# only if you want the deployment variables to seed the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Resend Email Integration
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=ashokrimal.com.np
RESEND_WEBHOOK_SECRET=
# Optional Resend Audience ID for newsletter subscriber collection.
RESEND_AUDIENCE_ID=
# Where contact-form submissions are emailed (falls back to ADMIN_EMAIL).
CONTACT_TO_EMAIL=

# Media & API integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ACCESS_TOKEN=
LASTFM_API_KEY=
GITHUB_TOKEN=
# Required for "Upload from device" in the studio and for scheduled backups
# (Vercel Blob). Backups are stored as private blobs under backups/.
BLOB_READ_WRITE_TOKEN=
# Vercel Cron sends this as "Authorization: Bearer <value>" to the daily backup
# at /api/cron/cms-backup. Without it that route refuses to run.
CRON_SECRET=
# Optional: set to "private" when BLOB_READ_WRITE_TOKEN belongs to a store that
# was created as private. Defaults to public, matching the media store.
CMS_BACKUP_BLOB_ACCESS=

# Optional: forwards browser errors posted to /api/client-error to Rollbar.
# Without it those reports only reach the server log.
ROLLBAR_SERVER_TOKEN=
# Optional: enable the studio's authenticator-code step. Generate a secret with
# `node scripts/admin-totp-setup.mjs owner@example.com` and paste it here.
ADMIN_TOTP_SECRET=

# Optional: passkey (fingerprint/face) sign-in. It uses the owner's session
# secret, so nothing has to be set to enable it — add a passkey from Studio →
# Security. Override these only when the site is served from another domain.
ADMIN_PASSKEY_SECRET=
ADMIN_PASSKEY_RP_ID=
ADMIN_PASSKEY_ORIGIN=

# Search engines. Each token only appears in the page's verification meta tag,
# so an engine can prove the domain; leave them empty until you have one.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=

# Optional: override the IndexNow key. A custom key needs its own
# public/<key>.txt returning the same value.
INDEXNOW_KEY=

# Gemini API (if used)
GEMINI_API_KEY=
