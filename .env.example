# Database connection (PostgreSQL / Cloud SQL)
# POSTGRES_URL, POSTGRES_PRISMA_URL and DATABASE_URL_UNPOOLED are also accepted,
# which is what Vercel Postgres and Neon provide.
DATABASE_URL=

# Better Auth configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional bootstrap for the admin owner. On a fresh deployment visit
# /admin/sign-in and create the owner there instead; that account is stored in
# Postgres and its password can be changed from /admin/account. Set all three
# only if you want the deployment variables to seed the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Resend Email Integration
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=ashokrimal.com.np
# Where contact-form submissions are emailed (falls back to ADMIN_EMAIL).
CONTACT_TO_EMAIL=

# Media & API integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ACCESS_TOKEN=
LASTFM_API_KEY=
# Required for "Upload from device" in the studio (Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# Gemini API (if used)
GEMINI_API_KEY=
