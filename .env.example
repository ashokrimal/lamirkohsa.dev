# Database connection (PostgreSQL / Cloud SQL)
# POSTGRES_URL, POSTGRES_PRISMA_URL and DATABASE_URL_UNPOOLED are also accepted,
# which is what Vercel Postgres and Neon provide.
DATABASE_URL=

# Better Auth configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin sign-in for the messages inbox. Checked on the server only; sign-in is
# disabled (503) until all three are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Resend Email Integration
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=ashokrimal.com.np
# Where contact-form submissions are emailed (falls back to ADMIN_EMAIL).
CONTACT_TO_EMAIL=

# Media & API integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ACCESS_TOKEN=
LASTFM_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Gemini API (if used)
GEMINI_API_KEY=
